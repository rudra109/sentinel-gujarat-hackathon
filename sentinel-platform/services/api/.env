# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@localhost:5432/sentinel_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MinIO / S3 Object Storage ────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sentinel-evidence
MINIO_PUBLIC_URL=http://localhost:9000

# ─── JWT ──────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Sentinel Sandbox ─────────────────────────────────────────────────────────
SENTINEL_INGEST_URL=https://sentinel.gujarat.gov.in/api/ingest
SENTINEL_API_KEY=
CAMERA_SYNC_INTERVAL_SECONDS=60

# ─── AI Event Stream ──────────────────────────────────────────────────────────
AI_EVENT_STREAM_KEY=sentinel:ai:events
HEALTH_EVENT_STREAM_KEY=sentinel:health:events

# ─── Deduplication Window ─────────────────────────────────────────────────────
DEDUP_WINDOW_SECONDS=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
